{
  "name": "llm-summary",
  "version": "1.0.0",
  "description": "LLM system to reliably summarise text within a target length range",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist/src"],
  "bin": {
    "llm-summary": "dist/cli/index.js"
  },
  "scripts": {
    "start": "tsx cli/index.ts",
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "17.4.1",
    "gpt-tokenizer": "3.4.0",
    "openai": "6.33.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
